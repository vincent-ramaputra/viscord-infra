# Copy to .env on the server (chmod 600, never commit it).

# Main site is https://$DOMAIN, voice is https://sfu.$DOMAIN. Both DNS A records -> PUBLIC_IP.
DOMAIN=demo.viscord.app
# The instance's Elastic IP (announced to browsers for WebRTC media).
PUBLIC_IP=

# openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=

# ES256 key pair used by guild-service to sign voice tickets and by sfu-service to verify them.
# Both are base64 of the whole PEM file (see README.md).
SFU_TICKET_PRIVATE_KEY=
SFU_TICKET_PUBLIC_KEY=

# Attachments, avatars and guild icons. Credentials come from the EC2 instance profile.
BUCKET_NAME=viscord-dev-409684965426-ap-southeast-3-an
S3_REGION=ap-southeast-3
CDN_ENDPOINT=https://cdn.dev.viscord.app
# Only if you're not using an instance profile:
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=

# Optional image tag overrides (defaults in docker-compose.yaml are the latest pushed tags as of 2026-10-05 evening; GUILD_TAG and MESSAGE_TAG must move together).
# AUTH_TAG= USER_TAG= GUILD_TAG= MESSAGE_TAG= WS_GATEWAY_TAG= SFU_TAG= WEB_TAG=
